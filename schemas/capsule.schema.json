{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research task capsule",
  "type": "object",
  "required": ["id", "objective", "workstream", "sourceBoundary", "evidenceCeiling"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "workstream": {"type": "string", "minLength": 1},
    "sourceBoundary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidenceCeiling": {"type": "string", "minLength": 1},
    "expectedArtifacts": {"type": "array", "items": {"type": "string"}}
  }
}
